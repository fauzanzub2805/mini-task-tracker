{
  "info": {
    "name": "Mini Task Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API berbasis Laravel session cookie, bukan Bearer token. Base URL tanpa /api. Jalankan folder 01–05 berurutan untuk smoke test; folder 06–08 hanya manual. Lihat postman/README.md."
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!['GET','HEAD','OPTIONS'].includes(pm.request.method)) {",
          " const token=pm.environment.get('xsrf_token');",
          " if (!token) throw new Error('Jalankan 01 Ambil session dan CSRF terlebih dahulu');",
          " pm.request.headers.upsert({key:'X-XSRF-TOKEN',value:token});",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const cookies=pm.response.headers.all().filter(h=>h.key.toLowerCase()==='set-cookie');",
          "for (const h of cookies) {",
          " const match=h.value.match(/^XSRF-TOKEN=([^;]*)/i);",
          " if(match) pm.environment.set('xsrf_token',decodeURIComponent(match[1]));",
          "}"
        ]
      }
    }
  ],
